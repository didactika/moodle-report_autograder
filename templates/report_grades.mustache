{{!
    @template report_autograder/index_page

    This template is used to render the index page of the autograder report.
}}
<div
    id="report-autograder-root"
    data-points-decimals="{{additionalData.points_decimals}}"
    data-separator-decimals="{{additionalData.separator_decimals}}"
>
    {{> report_autograder/partials/_breadcrumbs }}
    {{> report_autograder/partials/_search_input }}
    <div class="hero-unit">
        <table class="table">
            {{> report_autograder/partials/_table_header }}
            <tbody>
            {{^dataToRender.data}}
                {{> report_autograder/partials/_no_data_message }}
            {{/dataToRender.data}}
            {{#dataToRender.data}}
                {{> report_autograder/partials/_table_row }}
            {{/dataToRender.data}}
            </tbody>
        </table>
    </div>
</div>


{{!
    @template report_autograder/table_rows

    The rows of one page of the report, as the table fetches them.

    Context variables required for this template:
    * records - One row each, as report_autograder/table/_row takes it

    Example context (json):
    {
        "records": [
            {
                "rowkey": "12-3",
                "user_col": "Ana Lopez",
                "status": "Pending",
                "status_class": "autograder-badge autograder-badge-pending",
                "completed_at": "5 Mar 2030, 10:00",
                "completed_at_sort": 1898236800,
                "provisional_grade": "70",
                "will_grade": "Elena Ruiz"
            }
        ]
    }
}}
{{#records}}
    {{> report_autograder/table/_row }}
{{/records}}

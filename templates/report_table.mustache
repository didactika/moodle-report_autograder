<div id="autograder-report-container">
<table class="table table-striped table-hover">
    <thead class="table-light">
        <tr>
            <th scope="col">
                {{#str}} header:student, report_autograder {{/str}}
            </th>
            <th scope="col">{{#str}} header:external_status, report_autograder {{/str}}</th>
            <th scope="col">    
                {{#str}} header:completed_at, report_autograder {{/str}}
            </th>
            <th scope="col">{{#str}} header:grade, report_autograder {{/str}}</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody id="autograder-table-body">
        {{> report_autograder/table/skeleton_rows}}
    </tbody>
</table>
<div id="autograder-pagination-container" class="mt-4"></div>
</div>
{{!
    @template report_autograder/report_table

    The table's shell. The rows arrive later, from the web service.

    Context variables required for this template:
    * shows_course_column - Whether rows name their course
    * shows_activity_column - Whether rows name their activity
    * shows_group_column - Whether rows name the student's groups
    * skeletonRows - Placeholder rows shown until the first page arrives

    Example context (json):
    {
        "shows_course_column": false,
        "shows_activity_column": true,
        "shows_group_column": true,
        "skeletonRows": [[], []]
    }
}}
<div id="autograder-report-container" aria-busy="true"
    {{#forum_grade}}
    data-contextid="{{contextid}}"
    data-cmid="{{cmid}}"
    data-name="{{name}}"
    data-course-id="{{courseid}}"
    data-course-name="{{coursename}}"
    data-experimental-display-mode="{{experimentaldisplaymode}}"
    data-group="{{groupid}}"
    data-grading-component="{{gradingcomponent}}"
    data-grading-component-subtype="{{gradingcomponentsubtype}}"
    data-gradable-itemtype="forum"
    data-grade-only-active-users="{{gradeonlyactiveusers}}"
    {{#sendstudentnotifications}}data-send-student-notifications="1"{{/sendstudentnotifications}}
    {{/forum_grade}}
>
<div class="table-responsive autograder-table-scroll" tabindex="0" role="region"
    aria-label="{{#str}}pluginname, report_autograder{{/str}}">
<table class="table table-striped table-hover">
    <caption class="sr-only">{{#str}}pluginname, report_autograder{{/str}}</caption>
    <thead class="table-light">
        <tr>
            <th scope="col" class="autograder-sort-th" aria-sort="none">
                <button type="button"
                    class="autograder-sort-btn"
                    data-autograder-sort="user_name"
                    aria-pressed="false"
                    aria-label="{{#str}} sortby_name, report_autograder {{/str}}">
                    <span class="autograder-sort-label">{{#str}} header:student, report_autograder {{/str}}</span>
                    <span class="autograder-sort-icon-wrap d-none" aria-hidden="true">
                        <i class="fa autograder-sort-glyph" aria-hidden="true"></i>
                    </span>
                </button>
            </th>
            {{#shows_course_column}}
            <th scope="col">{{#str}} header:course, report_autograder {{/str}}</th>
            {{/shows_course_column}}
            {{#shows_activity_column}}
            <th scope="col">{{#str}} header:activity, report_autograder {{/str}}</th>
            {{/shows_activity_column}}
            {{#shows_group_column}}
            <th scope="col">{{#str}} header:groups, report_autograder {{/str}}</th>
            {{/shows_group_column}}
            <th scope="col">{{#str}} header:external_status, report_autograder {{/str}}</th>
            <th scope="col" class="autograder-sort-th" aria-sort="none">
                <button type="button"
                    class="autograder-sort-btn"
                    data-autograder-sort="completed_at_sort"
                    aria-pressed="false"
                    aria-label="{{#str}} sortby_date, report_autograder {{/str}}">
                    <span class="autograder-sort-label">{{#str}} header:completed_at, report_autograder {{/str}}</span>
                    <span class="autograder-sort-icon-wrap d-none" aria-hidden="true">
                        <i class="fa autograder-sort-glyph" aria-hidden="true"></i>
                    </span>
                </button>
            </th>
            <th scope="col" class="text-center">{{#str}} header:grade, report_autograder {{/str}}</th>
            <th scope="col">{{#str}} header:gradedby, report_autograder {{/str}}</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody id="autograder-table-body">
        {{> report_autograder/table/skeleton_rows}}
    </tbody>
</table>
</div>
<div id="autograder-pagination-container" class="mt-4"></div>
</div>

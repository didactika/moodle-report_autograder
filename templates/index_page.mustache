{{!
    @template report_autograder/index_page

    This template is used to render the index page of the autograder report.
}}
<div id="report-autograder">
    <nav role="navigation">
        <ol class="breadcrumb">
            {{#items}}
                {{#action}}
                    {{#iscourse}}
                        <li class="breadcrumb-item"><a style="font-weight: bold;" href="{{{action}}}"
                                                       {{#title}}title="{{title}}"{{/title}}>{{{text}}}</a></li>
                    {{/iscourse}}
                    {{^iscourse}}
                        <li class="breadcrumb-item"><a href="{{{action}}}"
                                                       {{#title}}title="{{title}}"{{/title}}>{{{text}}}</a></li>
                    {{/iscourse}}
                {{/action}}
                {{^action}}
                    <li class="breadcrumb-item">{{{text}}}</li>
                {{/action}}
            {{/items}}
        </ol>
    </nav>
    <div class="hero-unit">
        <table class="table">
            <thead class="table-light">
            <tr>
                <th scope="col">{{#str}} header:student, report_autograder {{/str}}</th>
                <th scope="col">{{#str}} header:delivery_date, report_autograder {{/str}}</th>
                <th scope="col">{{#str}} header:modifcation_date, report_autograder {{/str}}</th>
                <th scope="col">{{#str}} header:grade_date, report_autograder {{/str}}</th>
                <th scope="col">{{#str}} header:status, report_autograder {{/str}}</th>
                <th scope="col">{{#str}} header:grade, report_autograder {{/str}}</th>
            </tr>
            </thead>
            <tbody>
            {{^data_to_render}}
                <tr>
                    <td colspan="6" class="align-content-center"><h4>{{#str}} nothingtodisplay {{/str}}</h4></td>
                </tr>
            {{/data_to_render}}
            {{#data_to_render}}
                <tr>
                    <td>{{user_name}} </td>
                    <td>{{submission_date}}</td>
                    <td>{{submission_graded}}</td>
                    <td>{{date_to_grade}}</td>
                    <td>{{status}} </td>
                    <td>
                        <form class="form-grade" method="post" target="_self" role="form" enctype="multipart/form-data">
                            <div class="row">
                                <div class="col-6">
                                    <input type="text"
                                        {{#grade}} value="{{grade}}" {{/grade}}
                                        {{^grade}} placeholder="{{grade_placeholder}}" {{/grade}}
                                           class="number form-control"
                                           name="grade"
                                           data-toggle="tooltip"
                                           data-placement="top"
                                           title=""/>
                                    <input type="hidden" value="{{userid}}" name="userid">
                                    <input type="hidden" value="{{context_id}}" name="context_id">
                                    <input type="hidden" value="{{course_id}}" name="course_id">
                                    <input type="hidden" value="{{modid}}" name="modid">
                                    <input type="hidden" value="{{mod_type}}" name="module">
                                </div>
                                <div class="col-6">
                                    <button class="btn btn-primary" style="min-width: 6rem" >
                                        <span class="text-action-description">
                                            {{grade_action_description}}
                                        </span>
                                        <span class="loading hide">
                                            {{> core/loading }}
                                        </span>
                                        <span class="success-icon hide">
                                            <i class="fa fa-check" aria-hidden="true"></i>
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </form>

                    </td>
                </tr>
            {{/data_to_render}}
            </tbody>
        </table>
    </div>
</div>

{{#js}}
    require(
    ['jquery','report_autograder/main'],
    function($,Main,str) {
    var root = $('#report-autograder');
    var config = {};
    {{#additional_data}}
        config.points_decimals = {{points_decimals}};
        config.separator_decimals = "{{separator_decimals}}";
    {{/additional_data}}
    Main.init(root,config);
    });
{{/js}}
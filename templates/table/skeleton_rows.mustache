{{!
    @template report_autograder/table/skeleton_rows

    Placeholder rows shown until the first page of the report arrives.

    Context variables required for this template:
    * skeletonRows - One entry per placeholder row
    * shows_course_column - Whether the table has a course column
    * shows_activity_column - Whether the table has an activity column
    * shows_group_column - Whether the table has a group column

    Example context (json):
    {
        "skeletonRows": [[], []],
        "shows_course_column": true,
        "shows_activity_column": true,
        "shows_group_column": false
    }
}}
{{#skeletonRows}}
<tr aria-hidden="true">
    <td><span class="placeholder-glow"><span class="placeholder col-8"></span></span></td>
    {{#shows_course_column}}
    <td><span class="placeholder-glow"><span class="placeholder col-8"></span></span></td>
    {{/shows_course_column}}
    {{#shows_activity_column}}
    <td><span class="placeholder-glow"><span class="placeholder col-8"></span></span></td>
    {{/shows_activity_column}}
    {{#shows_group_column}}
    <td><span class="placeholder-glow"><span class="placeholder col-6"></span></span></td>
    {{/shows_group_column}}
    <td><span class="placeholder-glow"><span class="placeholder col-6"></span></span></td>
    <td><span class="placeholder-glow"><span class="placeholder col-8"></span></span></td>
    <td><span class="placeholder-glow"><span class="placeholder col-4"></span></span></td>
    <td><span class="placeholder-glow"><span class="placeholder col-8"></span></span></td>
    <td></td>
</tr>
{{/skeletonRows}}

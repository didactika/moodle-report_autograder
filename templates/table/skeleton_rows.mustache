{{!
    @template report_autograder/table/skeleton_rows

    Placeholder rows shown until the first page of the report arrives.

    Context variables required for this template:
    * skeletonRows - One entry per placeholder row
    * shows_course_column - Whether the table has a course column
    * shows_activity_column - Whether the table has an activity column
    * shows_group_column - Whether the table has a group column

    Example context (json):
    {
        "skeletonRows": [[], []],
        "shows_course_column": true,
        "shows_activity_column": true,
        "shows_group_column": false
    }
}}
{{#skeletonRows}}
<tr aria-hidden="true">
    <td class="autograder-student-cell border-0">
        <div class="autograder-skeleton avatar mr-2"></div>
        <div class="autograder-skeleton" style="width: 150px;"></div>
    </td>
    {{#shows_course_column}}
    <td class="border-0"><div class="autograder-skeleton"></div></td>
    {{/shows_course_column}}
    {{#shows_activity_column}}
    <td class="border-0"><div class="autograder-skeleton"></div></td>
    {{/shows_activity_column}}
    {{#shows_group_column}}
    <td class="border-0"><div class="autograder-skeleton"></div></td>
    {{/shows_group_column}}
    <td class="border-0"><div class="autograder-skeleton badge"></div></td>
    <td class="border-0"><div class="autograder-skeleton" style="width: 100px;"></div></td>
    <td class="border-0"><div class="autograder-skeleton" style="width: 80px;"></div></td>
    <td class="border-0"><div class="autograder-skeleton"></div></td>
    <td class="border-0"><div class="autograder-skeleton button"></div></td>
</tr>
{{/skeletonRows}}

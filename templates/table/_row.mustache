{{!
    @template report_autograder/table/_row

    One student's row.

    The details of the row open from one button at its end, in a dialog, in the colour of the most serious thing it explains.

    Context variables required for this template:
    * rowkey - Unique per activity and student
    * user_col - The student column, picture and name
    * status - What the badge says
    * status_class - How the badge looks
    * completed_at - The date, formatted
    * completed_at_sort - The date, for sorting
    * shows_groups / groups - The student's groups, where the table names them
    * graded_by / will_grade - Who graded it, or who is going to
    * hasdetails / detailstone / detailsinfo - Whether the row has something to explain, the colour of the most serious thing and
      whether it only informs

    Example context (json):
    {
        "rowkey": "12-3",
        "user_col": "Ana Lopez",
        "status": "Pending",
        "status_class": "badge badge-soft badge-dot rounded-pill text-bg-primary",
        "completed_at": "5 Mar 2030, 10:00",
        "completed_at_sort": 1898236800,
        "provisional_grade": "70",
        "shows_groups": true,
        "groups": "Group A",
        "will_grade": "Elena Ruiz",
        "hasdetails": true,
        "detailstone": "info",
        "detailsinfo": true
    }
}}
<tr data-record-id="{{rowkey}}">
    <td class="text-nowrap">
        {{{user_col}}}
    </td>

    {{#course_name}}
    <td>
        <a href="{{course_url}}">{{course_name}}</a>
    </td>
    {{/course_name}}

    {{#activity_name}}
    <td>
        <a href="{{activity_url}}">{{activity_name}}</a>
    </td>
    {{/activity_name}}

    {{#shows_groups}}
    <td class="text-nowrap">{{groups}}</td>
    {{/shows_groups}}

    <td><span class="{{status_class}}">{{status}}</span></td>

    <td class="text-nowrap" data-sort-value="{{completed_at_sort}}">{{completed_at}}</td>

    <td class="text-nowrap">
        {{#grade}}<strong>{{.}}</strong>{{/grade}}
        {{^grade}}
            {{#provisional_grade}}<span class="text-muted">{{.}}</span> <span class="badge badge-soft rounded-pill text-bg-secondary">{{#str}}grade_expected, report_autograder{{/str}}</span>{{/provisional_grade}}
            {{^provisional_grade}}<span class="text-muted">—</span>{{/provisional_grade}}
        {{/grade}}
    </td>

    <td>
        {{#graded_by}}{{.}}{{/graded_by}}
        {{^graded_by}}
            {{#will_grade}}<span class="text-muted">{{.}}</span>{{/will_grade}}
            {{^will_grade}}<span class="text-muted">—</span>{{/will_grade}}
        {{/graded_by}}
    </td>

    <td class="table-actions">
        {{#hasdetails}}
        <button type="button" class="btn btn-link btn-icon btn-sm btn-hint text-{{detailstone}}" data-action="row-details"
            data-rowkey="{{rowkey}}" aria-haspopup="dialog"
            title="{{#str}}info:row, report_autograder{{/str}}" aria-label="{{#str}}info:row, report_autograder{{/str}}">
            {{#detailsinfo}}{{#pix}}i/info, core{{/pix}}{{/detailsinfo}}{{^detailsinfo}}{{#pix}}i/warning, core{{/pix}}{{/detailsinfo}}
        </button>
        {{/hasdetails}}
        {{#grade_user_url}}
        <a class="btn btn-link btn-icon btn-sm text-primary" href="{{grade_user_url}}" title="{{#str}}gradeuser, report_autograder{{/str}}"
            aria-label="{{#str}}gradeuser, report_autograder{{/str}}">{{#pix}}i/grades, core{{/pix}}</a>
        {{/grade_user_url}}

        {{^grade_user_url}}
            {{#show_forum_grader}}
                <button class="btn btn-link btn-icon btn-sm text-primary"
                    title="{{#str}}gradeuser, report_autograder{{/str}}" aria-label="{{#str}}gradeuser, report_autograder{{/str}}"
                    type="button"
                    data-grade-action="launch"
                    data-grading-component="core_grades"
                    data-grading-component-subtype="point"
                    data-experimental-display-mode="0"
                    data-initialuserid="{{moodle_userid}}">{{#pix}}i/grades, core{{/pix}}</button>
            {{/show_forum_grader}}
        {{/grade_user_url}}
    </td>
</tr>

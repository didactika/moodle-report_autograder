<tr data-record-id="{{id}}">
    <td class="d-flex align-items-center">
        {{#user_picture_url}}
            <img src="{{user_picture_url}}" alt="{{user_name}}" class="userpicture rounded-circle mr-2" width="35" height="35">
        {{/user_picture_url}}
        {{#user_profile_url}}
            <a href="{{user_profile_url}}" target="_blank">{{user_name}}</a>
        {{/user_profile_url}}
        {{^user_profile_url}}
            {{user_name}}
        {{/user_profile_url}}
    </td>

    <td data-sort-value="{{submission_date_sort}}">{{submission_date}}</td>

    <td>
        <span class="badge badge-secondary">{{status}}</span>
    </td>

    <td data-sort-value="{{completed_at_sort}}">{{completed_at}}</td>

    <td>
        <input type="number" class="form-control manual-grade-input" value="{{#grade}}{{grade}}{{/grade}}" step="any" style="max-width: 100px;" />
    </td>

    <td>
        <button class="btn btn-primary manual-grade-btn" data-completion-id="{{id}}" title="{{#str}} manual_grading_send, report_autograder {{/str}}">
             <i class="fa fa-paper-plane"></i>
        </button>
    </td>
</tr>
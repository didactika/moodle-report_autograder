{{!
    @template report_autograder/table/_row

    One student's row.

    Context variables required for this template:
    * rowkey - Unique per activity and student
    * user_col - The student column, picture and name
    * status - What the badge says
    * status_class - How the badge looks
    * completed_at - The date, formatted
    * completed_at_sort - The date, for sorting
    * shows_groups / groups - The student's groups, where the table names them
    * graded_by / will_grade - Who graded it, or who is going to

    Example context (json):
    {
        "rowkey": "12-3",
        "user_col": "Ana Lopez",
        "status": "Pending",
        "status_class": "autograder-badge autograder-badge-pending",
        "completed_at": "5 Mar 2030, 10:00",
        "completed_at_sort": 1898236800,
        "provisional_grade": "70",
        "shows_groups": true,
        "groups": "Group A",
        "will_grade": "Elena Ruiz"
    }
}}
<tr data-record-id="{{rowkey}}">
    <td class="autograder-student-cell">
        {{{user_col}}}
    </td>

    {{#course_name}}
    <td>
        <a href="{{course_url}}">{{course_name}}</a>
    </td>
    {{/course_name}}

    {{#activity_name}}
    <td>
        <a href="{{activity_url}}">{{activity_name}}</a>
    </td>
    {{/activity_name}}

    {{#shows_groups}}
    <td>{{groups}}</td>
    {{/shows_groups}}

    <td>
        <span class="{{status_class}}">{{status}}</span>
        {{#failure_reason}}
        <a class="btn btn-link p-0 ml-1 icon-no-margin"
           role="button"
           data-container="body"
           data-toggle="popover"
           data-placement="right"
           data-content="{{failure_reason}}"
           data-html="true"
           tabindex="0"
           data-trigger="focus"
           aria-label="{{status}}">
            <i class="icon fa fa-circle-exclamation text-danger fa-fw" title="{{status}}" aria-hidden="true"></i>
        </a>
        {{/failure_reason}}
    </td>

    <td data-sort-value="{{completed_at_sort}}">
        {{completed_at}}
        {{#date_reason}}
        <a class="btn btn-link p-0 ml-1 icon-no-margin"
           role="button"
           data-container="body"
           data-toggle="popover"
           data-placement="right"
           data-content="{{date_reason}}"
           data-html="true"
           tabindex="0"
           data-trigger="focus"
           aria-label="{{#str}}helper, report_autograder{{/str}}">
            <i class="icon fa fa-circle-info text-muted fa-fw" aria-hidden="true"></i>
        </a>
        {{/date_reason}}
    </td>

    <td class="text-center">
        {{#grade}}
            {{.}}
        {{/grade}}
        {{^grade}}
            {{#provisional_grade}}
            {{.}} <a class="btn btn-link p-0 me-2 icon-no-margin"
                            role="button"
                            data-container="body"
                            data-toggle="popover"
                            data-placement="right"
                            data-content="{{#str}}grade_provisional_help, report_autograder{{/str}}"
                            data-html="true"
                            tabindex="0"
                            data-trigger="focus"
                            aria-label="{{#str}}helper, report_autograder{{/str}}">

            <i class="icon fa fa-circle-info text-info fa-fw " title="{{#str}}helper, report_autograder{{/str}}" aria-hidden="true"></i>
        </a>
            {{/provisional_grade}}
            {{#grade_problem}}
            <a class="btn btn-link p-0 icon-no-margin"
               role="button"
               data-container="body"
               data-toggle="popover"
               data-placement="right"
               data-content="{{grade_problem}}"
               data-html="true"
               tabindex="0"
               data-trigger="focus"
               aria-label="{{grade_problem}}">
                <i class="icon fa fa-triangle-exclamation text-warning fa-fw" aria-hidden="true"></i>
            </a>
            {{/grade_problem}}
        {{/grade}}
    </td>

    <td>
        {{#graded_by}}
            {{.}}
        {{/graded_by}}
        {{^graded_by}}
            {{#will_grade}}
            <span class="autograder-prospective">{{.}}</span>
            <a class="btn btn-link p-0 ml-1 icon-no-margin"
               role="button"
               data-container="body"
               data-toggle="popover"
               data-placement="left"
               data-content="{{#str}}gradedby_prospective_help, report_autograder{{/str}}"
               data-html="true"
               tabindex="0"
               data-trigger="focus"
               aria-label="{{#str}}gradedby_prospective, report_autograder{{/str}}">
                <i class="icon fa fa-circle-info text-info fa-fw" aria-hidden="true"></i>
            </a>
            {{/will_grade}}
            {{#will_grade_problem}}
            <a class="btn btn-link p-0 icon-no-margin"
               role="button"
               data-container="body"
               data-toggle="popover"
               data-placement="left"
               data-content="{{will_grade_problem}}"
               data-html="true"
               tabindex="0"
               data-trigger="focus"
               aria-label="{{will_grade_problem}}">
                <i class="icon fa fa-triangle-exclamation text-warning fa-fw" aria-hidden="true"></i>
            </a>
            {{/will_grade_problem}}
        {{/graded_by}}
    </td>

    <td>
        {{#grade_user_url}}
        <a class="btn btn-secondary" href="{{grade_user_url}}">{{#str}}gradeuser, report_autograder{{/str}}</a>
        {{/grade_user_url}}

        {{^grade_user_url}}
            {{#show_forum_grader}}
                <button class="btn btn-secondary autograder-row-grade-btn"
                    type="button"
                    data-grade-action="launch"
                    data-grading-component="core_grades"
                    data-grading-component-subtype="point"
                    data-experimental-display-mode="0"
                    data-initialuserid="{{moodle_userid}}">
                    {{#str}}gradeuser, report_autograder{{/str}}
                </button>
            {{/show_forum_grader}}
        {{/grade_user_url}}
    </td>
</tr>

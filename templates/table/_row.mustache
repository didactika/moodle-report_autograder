<tr data-record-id="{{id}}">
    <td class="d-flex align-items-center">
        {{{user_col}}}
    </td>

    <td data-sort-value="{{submission_date_sort}}">{{submission_date}}</td>

    <td>
        <span class="badge badge-secondary">{{status}}</span>
    </td>

    <td data-sort-value="{{completed_at_sort}}">{{completed_at}}</td>

    <td>
        <input type="number" class="form-control manual-grade-input" value="{{#grade}}{{grade}}{{/grade}}" step="any"
            style="max-width: 100px;" />
    </td>

    <td>
        <button class="btn btn-outline-primary manual-grade-btn" data-userid="{{moodle_userid}}"
            data-courseid="{{courseid}}" data-instanceid="{{instanceid}}" data-modname="{{modname}}"
            title="{{#str}} manual_grading_send, report_autograder {{/str}}">
            <i class="fa fa-floppy-disk"></i>
        </button>
    </td>
</tr>
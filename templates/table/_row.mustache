{{!
    @template report_autograder/table/_row

    One student's row.

    The popovers carry each attribute twice, once for Bootstrap 4 and once
    for Bootstrap 5: Moodle 4.5 reads data-toggle and Moodle 5.0 onwards
    reads data-bs-toggle, and each ignores the other's. Both are needed
    because these rows arrive after the page has loaded, so they are picked
    up by the delegated handler each Moodle installs, not by the one-off
    pass it makes over the page at load. Drop the data-* half when this
    plugin stops supporting 4.5.

    Context variables required for this template:
    * rowkey - Unique per activity and student
    * user_col - The student column, picture and name
    * status - What the badge says
    * status_class - How the badge looks
    * completed_at - The date, formatted
    * completed_at_sort - The date, for sorting
    * shows_groups / groups - The student's groups, where the table names them
    * graded_by / will_grade - Who graded it, or who is going to

    Example context (json):
    {
        "rowkey": "12-3",
        "user_col": "Ana Lopez",
        "status": "Pending",
        "status_class": "autograder-badge autograder-badge-pending",
        "completed_at": "5 Mar 2030, 10:00",
        "completed_at_sort": 1898236800,
        "provisional_grade": "70",
        "shows_groups": true,
        "groups": "Group A",
        "will_grade": "Elena Ruiz"
    }
}}
<tr data-record-id="{{rowkey}}">
    <td class="autograder-student-cell">
        {{{user_col}}}
    </td>

    {{#course_name}}
    <td>
        <a href="{{course_url}}">{{course_name}}</a>
    </td>
    {{/course_name}}

    {{#activity_name}}
    <td>
        <a href="{{activity_url}}">{{activity_name}}</a>
    </td>
    {{/activity_name}}

    {{#shows_groups}}
    <td>{{groups}}</td>
    {{/shows_groups}}

    <td>
        <span class="{{status_class}}">{{status}}</span>
        {{#failure_reason}}
        <a class="btn btn-link p-0 ml-1 icon-no-margin"
           role="button"
           data-container="body" data-bs-container="body"
           data-toggle="popover" data-bs-toggle="popover"
           data-placement="right" data-bs-placement="right"
           data-content="{{failure_reason}}" data-bs-content="{{failure_reason}}"
           data-html="true" data-bs-html="true"
           tabindex="0"
           data-trigger="focus" data-bs-trigger="focus"
           aria-label="{{status}}">
            <i class="icon fa fa-circle-exclamation text-danger fa-fw" title="{{status}}" aria-hidden="true"></i>
        </a>
        {{/failure_reason}}
    </td>

    <td data-sort-value="{{completed_at_sort}}">
        {{completed_at}}
        {{#date_reason}}
        <a class="btn btn-link p-0 ml-1 icon-no-margin"
           role="button"
           data-container="body" data-bs-container="body"
           data-toggle="popover" data-bs-toggle="popover"
           data-placement="right" data-bs-placement="right"
           data-content="{{date_reason}}" data-bs-content="{{date_reason}}"
           data-html="true" data-bs-html="true"
           tabindex="0"
           data-trigger="focus" data-bs-trigger="focus"
           aria-label="{{#str}}helper, report_autograder{{/str}}">
            <i class="icon fa fa-circle-info text-muted fa-fw" aria-hidden="true"></i>
        </a>
        {{/date_reason}}
    </td>

    <td class="text-center">
        {{#grade}}
            {{.}}
        {{/grade}}
        {{^grade}}
            {{#provisional_grade}}
            {{.}} <a class="btn btn-link p-0 me-2 icon-no-margin"
                            role="button"
                            data-container="body" data-bs-container="body"
                            data-toggle="popover" data-bs-toggle="popover"
                            data-placement="right" data-bs-placement="right"
                            data-content="{{#str}}grade_provisional_help, report_autograder{{/str}}" data-bs-content="{{#str}}grade_provisional_help, report_autograder{{/str}}"
                            data-html="true" data-bs-html="true"
                            tabindex="0"
                            data-trigger="focus" data-bs-trigger="focus"
                            aria-label="{{#str}}helper, report_autograder{{/str}}">

            <i class="icon fa fa-circle-info text-info fa-fw " title="{{#str}}helper, report_autograder{{/str}}" aria-hidden="true"></i>
        </a>
            {{/provisional_grade}}
            {{#grade_problem}}
            <a class="btn btn-link p-0 icon-no-margin"
               role="button"
               data-container="body" data-bs-container="body"
               data-toggle="popover" data-bs-toggle="popover"
               data-placement="right" data-bs-placement="right"
               data-content="{{grade_problem}}" data-bs-content="{{grade_problem}}"
               data-html="true" data-bs-html="true"
               tabindex="0"
               data-trigger="focus" data-bs-trigger="focus"
               aria-label="{{grade_problem}}">
                <i class="icon fa fa-triangle-exclamation text-warning fa-fw" aria-hidden="true"></i>
            </a>
            {{/grade_problem}}
        {{/grade}}
    </td>

    <td>
        {{#graded_by}}
            {{.}}
        {{/graded_by}}
        {{^graded_by}}
            {{#will_grade}}
            <span class="autograder-prospective">{{.}}</span>
            <a class="btn btn-link p-0 ml-1 icon-no-margin"
               role="button"
               data-container="body" data-bs-container="body"
               data-toggle="popover" data-bs-toggle="popover"
               data-placement="left" data-bs-placement="left"
               data-content="{{#str}}gradedby_prospective_help, report_autograder{{/str}}" data-bs-content="{{#str}}gradedby_prospective_help, report_autograder{{/str}}"
               data-html="true" data-bs-html="true"
               tabindex="0"
               data-trigger="focus" data-bs-trigger="focus"
               aria-label="{{#str}}gradedby_prospective, report_autograder{{/str}}">
                <i class="icon fa fa-circle-info text-info fa-fw" aria-hidden="true"></i>
            </a>
            {{/will_grade}}
            {{#will_grade_problem}}
            <a class="btn btn-link p-0 icon-no-margin"
               role="button"
               data-container="body" data-bs-container="body"
               data-toggle="popover" data-bs-toggle="popover"
               data-placement="left" data-bs-placement="left"
               data-content="{{will_grade_problem}}" data-bs-content="{{will_grade_problem}}"
               data-html="true" data-bs-html="true"
               tabindex="0"
               data-trigger="focus" data-bs-trigger="focus"
               aria-label="{{will_grade_problem}}">
                <i class="icon fa fa-triangle-exclamation text-warning fa-fw" aria-hidden="true"></i>
            </a>
            {{/will_grade_problem}}
        {{/graded_by}}
    </td>

    <td>
        {{#grade_user_url}}
        <a class="btn btn-secondary" href="{{grade_user_url}}">{{#str}}gradeuser, report_autograder{{/str}}</a>
        {{/grade_user_url}}

        {{^grade_user_url}}
            {{#show_forum_grader}}
                <button class="btn btn-secondary autograder-row-grade-btn"
                    type="button"
                    data-grade-action="launch"
                    data-grading-component="core_grades"
                    data-grading-component-subtype="point"
                    data-experimental-display-mode="0"
                    data-initialuserid="{{moodle_userid}}">
                    {{#str}}gradeuser, report_autograder{{/str}}
                </button>
            {{/show_forum_grader}}
        {{/grade_user_url}}
    </td>
</tr>

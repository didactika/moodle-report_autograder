{{!
    @template report_autograder/graders

    Who autograder would grade as: the courses where it is switched on, or one course with its graders and its students.

    It is written with the classes of Bootstrap and Moodle, which carry both names where Bootstrap 4 and Bootstrap 5 differ.

    Context variables required for this template:
    * formurl / overviewurl - Where the search submits, and the list of courses
    * search - What was searched
    * iscourse - Whether it is about one course
    * courses / hascourses - The courses of the list: id, name, fullname, activities, studentcount, graderlist, hasmore, moregraders,
      tone, statelabel, reporturl, studentsurl
    * course / reporturl / graders / hasgraders / gradercount / studentcount / onlyfallback - One course
    * filters / students / hasstudents - Its students and the filter that narrows them
    * emptymessage - What a list says when it has nothing
    * pager - The foot of the list: from, to, total, hasprev, hasnext, prevurl, nexturl, hiddenfields, peroptions

    Example context (json):
    {
        "formurl": "/report/autograder/graders.php",
        "overviewurl": "/report/autograder/graders.php",
        "search": "",
        "iscourse": false,
        "hascourses": true,
        "courses": [{
            "id": 2, "name": "MATH101", "fullname": "Calculus", "activities": 2, "studentcount": 40,
            "graderlist": "Ada Lovelace", "hasmore": false, "moregraders": 0, "tone": "success", "statelabel": "Ready",
            "reporturl": "/report/autograder/index.php?courseid=2", "studentsurl": "/report/autograder/graders.php?courseid=2"
        }],
        "pager": {
            "from": 1, "to": 1, "total": 1, "hasprev": false, "hasnext": false, "prevurl": "#", "nexturl": "#",
            "hiddenfields": [], "peroptions": [{"value": 24, "selected": true}]
        }
    }
}}
<div class="report-autograder-graders arp">
    <p class="text-muted mb-3">{{#str}}lead_graders, report_autograder{{/str}}</p>
    {{#iscourse}}
    <div class="autograder-graders-head mb-3">
        <a class="btn btn-link px-0" href="{{overviewurl}}">{{#pix}}i/previous, core{{/pix}} {{#str}}graders:back, report_autograder{{/str}}</a>
        <a class="btn btn-outline-secondary" href="{{reporturl}}">{{#str}}graders:openreport, report_autograder{{/str}}</a>
    </div>
    <div class="autograder-graders-title mb-3">
        <h3 class="h4 mb-0">{{course}}</h3>
        <span class="text-muted"><strong class="text-body">{{gradercount}}</strong> {{#str}}graders:gradercount, report_autograder{{/str}} ·
            <strong class="text-body">{{studentcount}}</strong> {{#str}}graders:studentcount, report_autograder{{/str}}</span>
    </div>
    {{^hasgraders}}
    <div class="alert alert-danger" role="alert">{{#str}}graders:nograders, report_autograder{{/str}}</div>
    {{/hasgraders}}
    {{#onlyfallback}}
    <div class="alert alert-warning" role="alert">{{#str}}graders:onlyfallback, report_autograder{{/str}}</div>
    {{/onlyfallback}}
    {{#hasgraders}}
    <div class="card mb-3">
        <div class="card-body">
            <h4 class="h6 mb-2">{{#str}}graders:possible, report_autograder{{/str}}</h4>
            <ul class="list-unstyled autograder-graders-names mb-2">
                {{#graders}}
                <li><span class="badge {{#isfallback}}badge-secondary{{/isfallback}}{{^isfallback}}badge-primary{{/isfallback}}">{{name}}{{#isfallback}} · {{#str}}graders:viafallback, report_autograder{{/str}}{{/isfallback}}</span></li>
                {{/graders}}
            </ul>
            <p class="small text-muted mb-0">{{#str}}graders:associationnote, report_autograder{{/str}}</p>
        </div>
    </div>
    {{/hasgraders}}
    {{/iscourse}}
    <div class="card">
        <form method="get" action="{{formurl}}" class="table-toolbar" role="search">
            {{#iscourse}}<input type="hidden" name="courseid" value="{{courseid}}">{{/iscourse}}
            <div class="table-toolbar-start">
                <div class="input-group">
                    <span class="input-group-text input-group-prepend">{{#pix}}a/search, core{{/pix}}</span>
                    <label class="sr-only visually-hidden" for="graders-search">{{#iscourse}}{{#str}}graders:search_students, report_autograder{{/str}}{{/iscourse}}{{^iscourse}}{{#str}}graders:search, report_autograder{{/str}}{{/iscourse}}</label>
                    <input type="search" class="form-control" id="graders-search" name="search" value="{{search}}" autocomplete="off"
                        placeholder="{{#iscourse}}{{#str}}graders:search_students, report_autograder{{/str}}{{/iscourse}}{{^iscourse}}{{#str}}graders:search, report_autograder{{/str}}{{/iscourse}}…">
                </div>
                {{#iscourse}}
                <select class="form-control form-select custom-select autograder-graders-filter" name="filter"
                    aria-label="{{#str}}graders:show, report_autograder{{/str}}" onchange="this.form.submit()">
                    {{#filters}}
                    <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/filters}}
                </select>
                {{/iscourse}}
                <button type="submit" class="btn btn-outline-secondary">{{#str}}filter_search, report_autograder{{/str}}</button>
            </div>
        </form>
        <div class="table-responsive">
            {{#iscourse}}
            <table class="table">
                <caption class="sr-only visually-hidden">{{#str}}graders:students, report_autograder{{/str}}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{#str}}graders:student, report_autograder{{/str}}</th>
                        <th scope="col">{{#str}}graders:grader, report_autograder{{/str}}</th>
                        <th scope="col">{{#str}}graders:note, report_autograder{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#students}}
                    <tr>
                        <td class="font-weight-bold fw-bold">{{name}}</td>
                        <td>{{#hasgrader}}{{grader}}{{/hasgrader}}{{^hasgrader}}<span class="text-muted">—</span>{{/hasgrader}}</td>
                        <td>
                            {{^hasgrader}}<span class="badge badge-danger">{{#str}}graders:nobodyfor, report_autograder{{/str}}</span>{{/hasgrader}}
                            {{#hasgrader}}{{#viafallback}}<span class="badge badge-secondary">{{#str}}graders:viafallback, report_autograder{{/str}}</span>{{/viafallback}}{{/hasgrader}}
                        </td>
                    </tr>
                    {{/students}}
                </tbody>
            </table>
            {{^hasstudents}}<p class="text-center text-muted p-5 mb-0" role="status">{{emptymessage}}</p>{{/hasstudents}}
            {{/iscourse}}
            {{^iscourse}}
            <table class="table">
                <caption class="sr-only visually-hidden">{{#str}}graders:heading, report_autograder{{/str}}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{#str}}graders:course, report_autograder{{/str}}</th>
                        <th scope="col">{{#str}}graders:activities, report_autograder{{/str}}</th>
                        <th scope="col">{{#str}}graders:graders, report_autograder{{/str}}</th>
                        <th scope="col">{{#str}}graders:students, report_autograder{{/str}}</th>
                        <th scope="col">{{#str}}graders:state, report_autograder{{/str}}</th>
                        <th scope="col"><span class="sr-only visually-hidden">{{#str}}graders:openreport, report_autograder{{/str}}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {{#courses}}
                    <tr>
                        <td>
                            <a class="font-weight-bold fw-bold" href="{{studentsurl}}">{{name}}</a>
                            <div class="small text-muted text-truncate">{{fullname}}</div>
                        </td>
                        <td>{{activities}}</td>
                        <td>{{#graderlist}}{{.}}{{/graderlist}}{{^graderlist}}<span class="text-muted">—</span>{{/graderlist}}{{#hasmore}} <span class="text-muted">{{#str}}graders:more, report_autograder, {{moregraders}}{{/str}}</span>{{/hasmore}}</td>
                        <td>{{studentcount}}</td>
                        <td><span class="badge badge-{{tone}}">{{statelabel}}</span></td>
                        <td class="text-right text-end text-nowrap">
                            <a class="btn btn-outline-secondary btn-sm" href="{{studentsurl}}">{{#str}}graders:seestudents, report_autograder{{/str}}</a>
                            <a class="btn btn-outline-secondary btn-sm" href="{{reporturl}}">{{#str}}graders:openreport, report_autograder{{/str}}</a>
                        </td>
                    </tr>
                    {{/courses}}
                </tbody>
            </table>
            {{^hascourses}}<p class="text-center text-muted p-5 mb-0" role="status">{{emptymessage}}</p>{{/hascourses}}
            {{/iscourse}}
        </div>
        {{#pager}}
        <div class="table-foot">
            <div class="autograder-foot">
                <form method="get" action="{{formurl}}" class="autograder-foot-size">
                    {{#hiddenfields}}<input type="hidden" name="{{name}}" value="{{value}}">{{/hiddenfields}}
                    <label for="graders-perpage">{{#str}}pagination:results_per_page, report_autograder{{/str}}</label>
                    <select id="graders-perpage" name="perpage" class="form-control form-select custom-select custom-select-sm form-select-sm"
                        onchange="this.form.submit()">
                        {{#peroptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{value}}</option>{{/peroptions}}
                    </select>
                </form>
                <div class="autograder-foot-end">
                    <span class="text-body" role="status">{{from}}–{{to}} {{#str}}pagination:of, report_autograder{{/str}} {{total}}</span>
                    <div class="btn-group" role="group" aria-label="{{#str}}pagination:label, report_autograder{{/str}}">
                        <a class="btn btn-outline-secondary btn-sm{{^hasprev}} disabled{{/hasprev}}" href="{{prevurl}}"
                            {{^hasprev}}aria-disabled="true" tabindex="-1"{{/hasprev}} aria-label="{{#str}}pagination:previous, report_autograder{{/str}}">{{#pix}}i/previous, core{{/pix}}</a>
                        <a class="btn btn-outline-secondary btn-sm{{^hasnext}} disabled{{/hasnext}}" href="{{nexturl}}"
                            {{^hasnext}}aria-disabled="true" tabindex="-1"{{/hasnext}} aria-label="{{#str}}pagination:next, report_autograder{{/str}}">{{#pix}}i/next, core{{/pix}}</a>
                    </div>
                </div>
            </div>
        </div>
        {{/pager}}
    </div>
</div>

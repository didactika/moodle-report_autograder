{{!
    @template report_autograder/graders

    Who autograder would grade as, in one course.

    Context variables required for this template:
    * formurl - Where the course picker submits
    * haschosen - Whether a course has been picked yet
    * course - Its shortname
    * graders - One entry per grader: id, name, count, students, viafallback
    * nobody / hasnobody / nobodycount - Students with no grader at all
    * total, truncated, max - How many students were walked

    Example context (json):
    {
        "formurl": "/report/autograder/graders.php",
        "haschosen": true,
        "course": "MATH101",
        "graders": [{"id": 4, "name": "Ada Lovelace", "count": 2, "students": ["A B"], "viafallback": false}],
        "hasnobody": false,
        "nobodycount": 0,
        "total": 2,
        "truncated": false,
        "max": 2000
    }
}}
<div class="report-autograder-graders">
    <form method="get" action="{{formurl}}" class="mb-3" id="graders-form">
        <label for="graders-courseid">{{#str}}graders:pickcourse, report_autograder{{/str}}</label>
        {{!
            Searched from the server as the reader types, never rendered in
            full: a campus can hold a hundred thousand courses. The option
            below is only the one already chosen, so the picker can show it.
        }}
        <div class="autograder-search-chip-wrapper">
        <select class="autograder-select-chip" id="graders-courseid" name="courseid"
                data-optiontype="anycourse"
                data-scopecmid="0"
                data-scopecourseid="0"
                data-placeholder="{{#str}}graders:courseidplaceholder, report_autograder{{/str}}">
            <option value="">{{#str}}graders:courseidplaceholder, report_autograder{{/str}}</option>
            {{#haschosen}}
            <option value="{{courseid}}" selected>{{course}}</option>
            {{/haschosen}}
        </select>
        </div>
        <button type="submit" class="btn btn-primary mt-2">{{#str}}graders:show, report_autograder{{/str}}</button>
    </form>

    {{#haschosen}}
    <p>
        <strong>{{course}}</strong> &mdash; {{#str}}graders:studentswalked, report_autograder, {{total}}{{/str}}
        <a href="{{reporturl}}" class="ml-2">{{#str}}graders:openreport, report_autograder{{/str}}</a>
    </p>

    {{#truncated}}
    <div class="alert alert-warning">{{#str}}graders:truncated, report_autograder, {{max}}{{/str}}</div>
    {{/truncated}}

    {{#hasnobody}}
    <div class="alert alert-danger">
        {{#str}}graders:nobody, report_autograder, {{nobodycount}}{{/str}}
        <ul class="mb-0 mt-2">
            {{#nobody}}
            <li>{{.}}</li>
            {{/nobody}}
        </ul>
    </div>
    {{/hasnobody}}

    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">{{#str}}graders:grader, report_autograder{{/str}}</th>
                <th scope="col">{{#str}}graders:students, report_autograder{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#graders}}
            <tr>
                <td>
                    {{name}}
                    {{#viafallback}}
                    <span class="badge badge-info ml-1">{{#str}}graders:viafallback, report_autograder{{/str}}</span>
                    {{/viafallback}}
                </td>
                <td>
                    <strong>{{count}}</strong>
                    {{#ischosen}}
                    <span class="badge badge-success ml-1">{{#str}}graders:wouldpick, report_autograder, {{chosen}}{{/str}}</span>
                    {{/ischosen}}
                    <div class="text-muted small">
                        {{#students}}{{.}}; {{/students}}
                    </div>
                </td>
            </tr>
            {{/graders}}
            {{^graders}}
            <tr>
                <td colspan="2">{{#str}}graders:none, report_autograder{{/str}}</td>
            </tr>
            {{/graders}}
        </tbody>
    </table>
    {{/haschosen}}

    {{^haschosen}}
    <p class="text-muted">{{#str}}graders:intro, report_autograder{{/str}}</p>
    {{/haschosen}}
</div>

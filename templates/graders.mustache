{{!
    @template report_autograder/graders

    Who autograder would grade as, in one course.

    Context variables required for this template:
    * formurl - Where the course picker submits
    * haschosen - Whether a course has been picked yet
    * course - Its name
    * graders / hasgraders / gradercount - Everybody who could grade here
    * studentcount - How many gradable students the course has
    * showstudents / studentsurl - The per-student list, fetched on request
    * studentlist - One page of it, when it was asked for

    Example context (json):
    {
        "formurl": "/report/autograder/graders.php",
        "haschosen": true,
        "course": "MATH101",
        "graders": [{"id": 4, "name": "Ada Lovelace", "isfallback": false}],
        "hasgraders": true,
        "gradercount": 1,
        "studentcount": 40,
        "reporturl": "/report/autograder/index.php?courseid=2",
        "showstudents": true,
        "studentsurl": "/report/autograder/graders.php?courseid=2&students=1",
        "studentlist": {
            "students": [{"name": "A B", "grader": "Ada Lovelace", "hasgrader": true, "viafallback": false}],
            "pageshown": 1, "pages": 2, "hasprev": false, "hasnext": true,
            "prevurl": "#", "nexturl": "#"
        }
    }
}}
<div class="report-autograder-graders">
    <form method="get" action="{{formurl}}" class="mb-3" id="graders-form">
        <label for="graders-courseid">{{#str}}graders:pickcourse, report_autograder{{/str}}</label>
        {{!
            Searched from the server as the reader types, never rendered in
            full: a campus can hold a hundred thousand courses. The option
            below is only the one already chosen, so the picker can show it.
        }}
        <div class="autograder-search-chip-wrapper">
        <select class="autograder-select-chip" id="graders-courseid" name="courseid"
                data-optiontype="anycourse"
                data-scopecmid="0"
                data-scopecourseid="0"
                data-placeholder="{{#str}}graders:courseidplaceholder, report_autograder{{/str}}">
            <option value="">{{#str}}graders:courseidplaceholder, report_autograder{{/str}}</option>
            {{#haschosen}}
            <option value="{{courseid}}" selected>{{course}}</option>
            {{/haschosen}}
        </select>
        </div>
        <button type="submit" class="btn btn-primary mt-2">{{#str}}graders:show, report_autograder{{/str}}</button>
    </form>

    {{#haschosen}}
    <p>
        <strong>{{course}}</strong>
        &mdash; {{#str}}graders:gradercount, report_autograder, {{gradercount}}{{/str}}
        &mdash; {{#str}}graders:studentcount, report_autograder, {{studentcount}}{{/str}}
        <a href="{{reporturl}}" class="ml-2">{{#str}}graders:openreport, report_autograder{{/str}}</a>
    </p>

    {{^hasgraders}}
    <div class="alert alert-danger">{{#str}}graders:nograders, report_autograder{{/str}}</div>
    {{/hasgraders}}

    {{#hasgraders}}
    <h3 class="h5">{{#str}}graders:possible, report_autograder{{/str}}</h3>
    <ul class="list-unstyled">
        {{#graders}}
        <li>
            {{name}}
            {{#isfallback}}
            <span class="badge badge-info ml-1">{{#str}}graders:viafallback, report_autograder{{/str}}</span>
            {{/isfallback}}
        </li>
        {{/graders}}
    </ul>
    {{/hasgraders}}

    {{! Who would grade whom is decided per student, so the list of students is
        only fetched when it is asked for, and then a page at a time. }}
    {{^showstudents}}
    <p><a href="{{studentsurl}}" class="btn btn-secondary">{{#str}}graders:seestudents, report_autograder{{/str}}</a></p>
    {{/showstudents}}

    {{#showstudents}}
    {{#studentlist}}
    <h3 class="h5">{{#str}}graders:students, report_autograder{{/str}}</h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">{{#str}}graders:student, report_autograder{{/str}}</th>
                <th scope="col">{{#str}}graders:grader, report_autograder{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#students}}
            <tr>
                <td>{{name}}</td>
                <td>
                    {{#hasgrader}}
                    {{grader}}
                    {{#viafallback}}
                    <span class="badge badge-info ml-1">{{#str}}graders:viafallback, report_autograder{{/str}}</span>
                    {{/viafallback}}
                    {{/hasgrader}}
                    {{^hasgrader}}
                    <span class="text-danger">{{#str}}graders:nobodyfor, report_autograder{{/str}}</span>
                    {{/hasgrader}}
                </td>
            </tr>
            {{/students}}
            {{^students}}
            <tr><td colspan="2">{{#str}}graders:none, report_autograder{{/str}}</td></tr>
            {{/students}}
        </tbody>
    </table>

    <nav class="d-flex align-items-center" aria-label="{{#str}}graders:students, report_autograder{{/str}}">
        {{#hasprev}}
        <a class="btn btn-sm btn-outline-secondary mr-2" href="{{prevurl}}">{{#str}}pagination:previous, report_autograder{{/str}}</a>
        {{/hasprev}}
        <span class="text-muted">{{pageshown}} / {{pages}}</span>
        {{#hasnext}}
        <a class="btn btn-sm btn-outline-secondary ml-2" href="{{nexturl}}">{{#str}}pagination:next, report_autograder{{/str}}</a>
        {{/hasnext}}
    </nav>
    {{/studentlist}}
    {{/showstudents}}
    {{/haschosen}}

    {{^haschosen}}
    <p class="text-muted">{{#str}}graders:intro, report_autograder{{/str}}</p>
    {{/haschosen}}
</div>

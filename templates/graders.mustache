{{!
    @template report_autograder/graders

    Who autograder would grade as: the courses where it is switched on, or one course with its graders and its students.

    It is written with the classes of Bootstrap, Moodle and the Didactika design system, which carry both names where Bootstrap 4 and
    Bootstrap 5 differ.

    Context variables required for this template:
    * formurl / overviewurl - Where the search submits, and the list of courses
    * search - What was searched
    * iscourse - Whether it is about one course
    * courses / hascourses - The courses of the list: id, name, fullname, activities, studentcount, graderlist, hasmore, moregraders,
      tone, statelabel, reporturl, studentsurl
    * course / reporturl / graders / hasgraders / gradercount / studentcount / onlyfallback - One course
    * filters / students / hasstudents - Its students and the filter that narrows them
    * emptymessage - What a list says when it has nothing
    * pager - The foot of the list: from, to, total, hasprev, hasnext, prevurl, nexturl, hiddenfields, peroptions

    Example context (json):
    {
        "formurl": "/report/autograder/graders.php",
        "overviewurl": "/report/autograder/graders.php",
        "search": "",
        "iscourse": false,
        "hascourses": true,
        "courses": [{
            "id": 2, "name": "MATH101", "fullname": "Calculus", "activities": 2, "studentcount": 40,
            "graderlist": "Ada Lovelace", "hasmore": false, "moregraders": 0, "tone": "success", "statelabel": "Ready",
            "reporturl": "/report/autograder/index.php?courseid=2", "studentsurl": "/report/autograder/graders.php?courseid=2"
        }],
        "pager": {
            "from": 1, "to": 1, "total": 1, "hasprev": false, "hasnext": false, "prevurl": "#", "nexturl": "#",
            "hiddenfields": [], "peroptions": [{"value": 12, "label": "12", "selected": true}, {"value": -1, "label": "All", "selected": false}]
        }
    }
}}
<div class="report-autograder-graders arp">
    <p class="text-muted mb-0">{{#str}}lead_graders, report_autograder{{/str}}</p>
    {{#iscourse}}
    <div class="d-flex flex-wrap align-items-center justify-content-between">
        <a class="btn btn-link px-0" href="{{overviewurl}}">{{#pix}}i/previous, core{{/pix}} {{#str}}graders:back, report_autograder{{/str}}</a>
        <a class="btn btn-link btn-icon text-info" href="{{reporturl}}" title="{{#str}}graders:openreport, report_autograder{{/str}}"
            aria-label="{{#str}}graders:openreport, report_autograder{{/str}}">{{#pix}}i/report, core{{/pix}}</a>
    </div>
    <div>
        <h3 class="h4 mb-1">{{course}}</h3>
        <span class="text-muted"><strong class="text-body">{{gradercount}}</strong> {{#str}}graders:gradercount, report_autograder{{/str}} ·
            <strong class="text-body">{{studentcount}}</strong> {{#str}}graders:studentcount, report_autograder{{/str}}</span>
    </div>
    {{^hasgraders}}
    <div class="alert alert-danger mb-0" role="alert">{{#str}}graders:nograders, report_autograder{{/str}}</div>
    {{/hasgraders}}
    {{#onlyfallback}}
    <div class="alert alert-warning mb-0" role="alert">{{#str}}graders:onlyfallback, report_autograder{{/str}}</div>
    {{/onlyfallback}}
    {{#hasgraders}}
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">{{#str}}graders:possible, report_autograder{{/str}}</h4>
            <p class="mb-2">
                {{#graders}}
                <span class="badge badge-soft rounded-pill {{#isfallback}}text-bg-secondary{{/isfallback}}{{^isfallback}}text-bg-primary{{/isfallback}}">{{name}}{{#isfallback}} · {{#str}}graders:viafallback, report_autograder{{/str}}{{/isfallback}}</span>
                {{/graders}}
            </p>
            <p class="small text-muted mb-0">{{#str}}graders:associationnote, report_autograder{{/str}}</p>
        </div>
    </div>
    {{/hasgraders}}
    {{/iscourse}}
    <div class="card">
        <form method="get" action="{{formurl}}" class="table-toolbar" role="search">
            {{#iscourse}}<input type="hidden" name="courseid" value="{{courseid}}">{{/iscourse}}
            <div class="table-toolbar-start">
                <div class="dd-searchbox">
                    {{#pix}}a/search, core{{/pix}}
                    <label class="sr-only visually-hidden" for="graders-search">{{#iscourse}}{{#str}}graders:search_students, report_autograder{{/str}}{{/iscourse}}{{^iscourse}}{{#str}}graders:search, report_autograder{{/str}}{{/iscourse}}</label>
                    <input type="search" class="form-control" id="graders-search" name="search" value="{{search}}" autocomplete="off"
                        placeholder="{{#iscourse}}{{#str}}graders:search_students, report_autograder{{/str}}{{/iscourse}}{{^iscourse}}{{#str}}graders:search, report_autograder{{/str}}{{/iscourse}}">
                </div>
                {{#iscourse}}
                <label class="sr-only visually-hidden" for="graders-filter">{{#str}}graders:show, report_autograder{{/str}}</label>
                <span class="dd-select-filter">
                    <select class="custom-select form-select dd-select{{#filterset}} dd-select-set border-primary{{/filterset}}" id="graders-filter" name="filter" data-submit-on-change>
                        {{#filters}}
                        <option value="{{value}}" {{#selected}}selected{{/selected}}{{#base}} hidden{{/base}}>{{label}}</option>
                        {{/filters}}
                    </select>
                    {{#filterset}}
                    <a class="dd-select-clear" href="{{filterclearurl}}"
                        title="{{#str}}filter_clear, report_autograder{{/str}}: {{#str}}graders:show, report_autograder{{/str}}"
                        aria-label="{{#str}}filter_clear, report_autograder{{/str}}: {{#str}}graders:show, report_autograder{{/str}}">{{#pix}}e/cancel, core{{/pix}}</a>
                    {{/filterset}}
                </span>
                {{/iscourse}}
            </div>
        </form>
        <div class="table-responsive" data-region="tablewrap">
            {{#iscourse}}
            {{#hasstudents}}
            <table class="table">
                <caption class="sr-only visually-hidden">{{#str}}graders:students, report_autograder{{/str}}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{#str}}graders:student, report_autograder{{/str}}</th>
                        <th scope="col">{{#str}}graders:grader, report_autograder{{/str}}</th>
                        <th scope="col">{{#str}}graders:note, report_autograder{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#students}}
                    <tr>
                        <th scope="row">{{name}}</th>
                        <td>{{#hasgrader}}{{grader}}{{/hasgrader}}{{^hasgrader}}<span class="text-muted">—</span>{{/hasgrader}}</td>
                        <td>
                            {{^hasgrader}}<span class="badge badge-soft badge-dot rounded-pill text-bg-danger">{{#str}}graders:nobodyfor, report_autograder{{/str}}</span>{{/hasgrader}}
                            {{#hasgrader}}{{#viafallback}}<span class="badge badge-soft rounded-pill text-bg-secondary">{{#str}}graders:viafallback, report_autograder{{/str}}</span>{{/viafallback}}{{/hasgrader}}
                        </td>
                    </tr>
                    {{/students}}
                </tbody>
            </table>
            {{/hasstudents}}
            {{^hasstudents}}<div class="dd-empty" data-region="empty" role="status"><span class="dd-tile dd-tile-lg">{{{emptyicon}}}</span><p class="dd-empty-text">{{emptymessage}}</p></div>{{/hasstudents}}
            {{/iscourse}}
            {{^iscourse}}
            {{#hascourses}}
            <table class="table">
                <caption class="sr-only visually-hidden">{{#str}}graders:heading, report_autograder{{/str}}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{#str}}graders:course, report_autograder{{/str}}</th>
                        <th scope="col">{{#str}}graders:activities, report_autograder{{/str}}</th>
                        <th scope="col">{{#str}}graders:graders, report_autograder{{/str}}</th>
                        <th scope="col">{{#str}}graders:students, report_autograder{{/str}}</th>
                        <th scope="col">{{#str}}graders:state, report_autograder{{/str}}</th>
                        <th scope="col" class="table-actions"><span class="sr-only visually-hidden">{{#str}}graders:openreport, report_autograder{{/str}}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {{#courses}}
                    <tr>
                        <th scope="row">
                            <a href="{{studentsurl}}">{{name}}</a>
                            <div class="small text-muted text-truncate font-weight-normal fw-normal">{{fullname}}</div>
                        </th>
                        <td>{{activities}}</td>
                        <td>{{#graderlist}}{{.}}{{/graderlist}}{{^graderlist}}<span class="text-muted">—</span>{{/graderlist}}{{#hasmore}} <span class="text-muted">{{#str}}graders:more, report_autograder, {{moregraders}}{{/str}}</span>{{/hasmore}}</td>
                        <td>{{studentcount}}</td>
                        <td><span class="badge badge-soft badge-dot rounded-pill text-bg-{{tone}}">{{statelabel}}</span></td>
                        <td class="table-actions">
                            <a class="btn btn-link btn-icon btn-sm text-primary" href="{{studentsurl}}" title="{{#str}}graders:seestudents, report_autograder{{/str}}"
                                aria-label="{{#str}}graders:seestudents, report_autograder{{/str}}">{{#pix}}i/users, core{{/pix}}</a>
                            <a class="btn btn-link btn-icon btn-sm text-info" href="{{reporturl}}" title="{{#str}}graders:openreport, report_autograder{{/str}}"
                                aria-label="{{#str}}graders:openreport, report_autograder{{/str}}">{{#pix}}i/report, core{{/pix}}</a>
                        </td>
                    </tr>
                    {{/courses}}
                </tbody>
            </table>
            {{/hascourses}}
            {{^hascourses}}<div class="dd-empty" data-region="empty" role="status"><span class="dd-tile dd-tile-lg">{{{emptyicon}}}</span><p class="dd-empty-text">{{emptymessage}}</p></div>{{/hascourses}}
            {{/iscourse}}
        </div>
        {{#pager}}
        <div class="table-foot">
            <div class="dd-pager">
                <form method="get" action="{{formurl}}" class="dd-pager-size">
                    {{#hiddenfields}}<input type="hidden" name="{{name}}" value="{{value}}">{{/hiddenfields}}
                    <label for="graders-perpage" class="mb-0">{{#str}}pagination:results_per_page, report_autograder{{/str}}</label>
                    <select id="graders-perpage" name="perpage" class="custom-select form-select form-select-sm custom-select-sm dd-select" data-submit-on-change>
                        {{#peroptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/peroptions}}
                    </select>
                </form>
                <div class="dd-pager-end">
                    <span class="dd-pager-range" role="status">{{from}}–{{to}} {{#str}}pagination:of, report_autograder{{/str}} {{total}}</span>
                    <div class="dd-pager-arrows">
                        {{#hasprev}}<a class="btn btn-outline-secondary btn-sm btn-icon" href="{{prevurl}}" title="{{#str}}pagination:previous, report_autograder{{/str}}" aria-label="{{#str}}pagination:previous, report_autograder{{/str}}">{{#pix}}i/previous, core{{/pix}}</a>{{/hasprev}}
                        {{^hasprev}}<button type="button" class="btn btn-outline-secondary btn-sm btn-icon" disabled aria-label="{{#str}}pagination:previous, report_autograder{{/str}}">{{#pix}}i/previous, core{{/pix}}</button>{{/hasprev}}
                        {{#hasnext}}<a class="btn btn-outline-secondary btn-sm btn-icon" href="{{nexturl}}" title="{{#str}}pagination:next, report_autograder{{/str}}" aria-label="{{#str}}pagination:next, report_autograder{{/str}}">{{#pix}}i/next, core{{/pix}}</a>{{/hasnext}}
                        {{^hasnext}}<button type="button" class="btn btn-outline-secondary btn-sm btn-icon" disabled aria-label="{{#str}}pagination:next, report_autograder{{/str}}">{{#pix}}i/next, core{{/pix}}</button>{{/hasnext}}
                    </div>
                </div>
            </div>
        </div>
        {{/pager}}
    </div>
</div>

{{!
    @template report_autograder/partials/_filters

    Filter form for autograder report.

    Context variables:
    * filters.searchname - Search name filter value
    * filters.submission_date_from - Submission date start value
    * filters.submission_date_to - Submission date end value
    * filters.grading_date_from - Grading date start value
    * filters.grading_date_to - Grading date end value
    * filters.grade - Grade filter value
    * filters.status - Selected status filter value
    * filters.status_pending - Boolean if pending status is selected
    * filters.status_waiting_for_due_date - Boolean if waiting_for_due_date status is selected
    * filters.status_waiting_for_grading - Boolean if waiting_for_grading status is selected
    * filters.status_ready_to_grade - Boolean if ready_to_grade status is selected
    * filters.status_grading - Boolean if grading status is selected
    * filters.status_graded - Boolean if graded status is selected
    * filters.status_failed - Boolean if failed status is selected
    * filters.status_skipped - Boolean if skipped status is selected
    * filters.status_manual_grading - Boolean if manual_grading status is selected
    * filters.has_active_filters - Boolean if any filter is active
    * filters.active_count - Number of active filters
    * filters.active_searchname - Label for active search name filter
    * filters.active_datefrom - Label for active date from filter
    * filters.active_dateto - Label for active date to filter
    * filters.active_grade - Label for active grade filter
    * filters.active_status_label - Label for active status filter
    * filter_action_url - URL to submit the filter form to (typically index.php)
}}

<div class="d-flex justify-content-between mb-3 mt-3">
    <div class="me-2 autograder-quick-search-wrapper">
        <i class="fa fa-search autograder-quick-search-icon" aria-hidden="true"></i>
        <input type="text" class="form-control shadow-none autograder-quick-search-input" placeholder="{{#str}}filter_search, report_autograder{{/str}}..." aria-label="{{#str}}filter_search, report_autograder{{/str}}" id="autograder-quick-search-input">
    </div>


    <div class="btn-group">
        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" id="autograder-filter-dropdown-btn">
            <i class="fa fa-filter"></i> {{#str}}filter_button, report_autograder{{/str}}
            {{#filters.has_active_filters}}
            <span class="badge badge-pill badge-primary ml-1">{{filters.active_count}}</span>
            {{/filters.has_active_filters}}
        </button>
        <div class="dropdown-menu dropdown-menu-right autograder-filter-dropdown-menu" style="min-width: 350px;" onclick="event.stopPropagation();">
            <form method="get" action="{{filter_action_url}}" id="autograder-filter-form">
                <div class="px-4 py-3">

                    <div class="mb-3">
                        <label for="submission_date_range" class="d-block mb-2">{{#str}}filter_submission_date, report_autograder{{/str}}</label>
                        <input type="text" id="submission_date_range" class="form-control form-control-sm autograder-daterange-input" autocomplete="off" placeholder="YYYY-MM-DD - YYYY-MM-DD">
                        <input type="hidden" name="submission_date_from" id="submission_date_from" value="{{filters.submission_date_from}}">
                        <input type="hidden" name="submission_date_to" id="submission_date_to" value="{{filters.submission_date_to}}">
                    </div>

                    <div class="mb-3">
                        <label for="grading_date_range" class="d-block mb-2">{{#str}}filter_grading_date, report_autograder{{/str}}</label>
                        <input type="text" id="grading_date_range" class="form-control form-control-sm autograder-daterange-input" autocomplete="off" placeholder="YYYY-MM-DD - YYYY-MM-DD">
                        <input type="hidden" name="grading_date_from" id="grading_date_from" value="{{filters.grading_date_from}}">
                        <input type="hidden" name="grading_date_to" id="grading_date_to" value="{{filters.grading_date_to}}">
                    </div>

                    <div class="mb-3">
                        <label for="grade">{{#str}}filter_grade, report_autograder{{/str}}</label>
                        <input type="number" name="grade" id="grade" value="{{filters.grade}}" class="form-control" placeholder="{{#str}}filter_grade_placeholder, report_autograder{{/str}}">
                    </div>


                    <div class="mb-3">
                        <label for="status">{{#str}}filter_status, report_autograder{{/str}}</label>
                        <div class="mb-3">
                              <label for="status">{{#str}}filter_status, report_autograder{{/str}}</label>
                              <input type="text" name="status" id="status" value="{{filters.status}}" class="form-control" placeholder="Ej: PENDING, GRADED...">
                        </div>
                    </div>

                    <div class="dropdown-divider"></div>

                    <div class="d-flex justify-content-between">
                        <a href="{{filter_action_url}}" class="btn btn-secondary btn-sm">
                            <i class="fa fa-times"></i> {{#str}}filter_clear, report_autograder{{/str}}
                        </a>
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fa fa-search"></i> {{#str}}filter_search, report_autograder{{/str}}
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{{#js}}
require(['jquery'], function($) {
    var format = 'YYYY-MM-DD';
    var separator = ' - ';

    var loadCss = function(href) {
        return new Promise(function(resolve) {
            if (document.querySelector('link[href="' + href + '"]')) {
                resolve();
                return;
            }

            var link = document.createElement('link');
            link.rel = 'stylesheet';
            link.href = href;
            link.onload = resolve;
            link.onerror = resolve;
            document.head.appendChild(link);
        });
    };

    var loadScript = function(src, forceGlobal) {
        return new Promise(function(resolve, reject) {
            if (document.querySelector('script[src="' + src + '"]')) {
                resolve();
                return;
            }

            var previousDefine = null;
            if (forceGlobal && typeof window.define === 'function' && window.define.amd) {
                previousDefine = window.define;
                window.define = undefined;
            }

            var restoreDefine = function() {
                if (previousDefine) {
                    window.define = previousDefine;
                }
            };

            var script = document.createElement('script');
            script.src = src;
            script.async = true;
            script.onload = function() {
                restoreDefine();
                resolve();
            };
            script.onerror = function() {
                restoreDefine();
                reject();
            };
            document.head.appendChild(script);
        });
    };

    var ensureDateRangeAssets = function() {
        var cssUrl = 'https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css';
        var momentUrl = 'https://cdn.jsdelivr.net/npm/moment@2.30.1/min/moment.min.js';
        var pickerUrl = 'https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js';

        return loadCss(cssUrl)
            .then(function() {
                if (typeof window.moment === 'undefined') {
                    return loadScript(momentUrl, true);
                }
                return Promise.resolve();
            })
            .then(function() {
                if (!$.fn.daterangepicker) {
                    return loadScript(pickerUrl, true);
                }
                return Promise.resolve();
            });
    };

    var initRangePicker = function(inputSelector, fromSelector, toSelector) {
        var input = $(inputSelector);
        var fromInput = $(fromSelector);
        var toInput = $(toSelector);

        if (!input.length || !fromInput.length || !toInput.length || !$.fn.daterangepicker || typeof window.moment === 'undefined') {
            return;
        }

        var options = {
            autoUpdateInput: false,
            linkedCalendars: false,
            opens: 'left',
            locale: {
                format: format,
                separator: separator,
                cancelLabel: 'Clear'
            }
        };

        if (fromInput.val() && toInput.val()) {
            options.startDate = window.moment(fromInput.val(), format);
            options.endDate = window.moment(toInput.val(), format);
            input.val(fromInput.val() + separator + toInput.val());
        }

        input.daterangepicker(options);

        input.on('apply.daterangepicker', function(ev, picker) {
            var start = picker.startDate.format(format);
            var end = picker.endDate.format(format);
            fromInput.val(start);
            toInput.val(end);
            input.val(start + separator + end);
        });

        input.on('cancel.daterangepicker', function() {
            fromInput.val('');
            toInput.val('');
            input.val('');
        });
    };

    ensureDateRangeAssets().then(function() {
        initRangePicker('#submission_date_range', '#submission_date_from', '#submission_date_to');
        initRangePicker('#grading_date_range', '#grading_date_from', '#grading_date_to');
    }).catch(function() {
        return;
    });
});
{{/js}}
{{#filters.has_active_filters}}
<div class="alert alert-info mb-3">
    <strong>{{#str}}filter_active, report_autograder{{/str}}</strong>
    {{#filters.active_searchname}}
    <span class="badge badge-secondary ml-1">{{#str}}filter_active_searchname, report_autograder{{/str}} {{filters.active_searchname}}</span>
    {{/filters.active_searchname}}
    {{#filters.active_datefrom}}
    <span class="badge badge-secondary ml-1">{{#str}}filter_active_datefrom, report_autograder{{/str}} {{filters.active_datefrom}}</span>
    {{/filters.active_datefrom}}
    {{#filters.active_dateto}}
    <span class="badge badge-secondary ml-1">{{#str}}filter_active_dateto, report_autograder{{/str}} {{filters.active_dateto}}</span>
    {{/filters.active_dateto}}
    {{#filters.active_grade}}
    <span class="badge badge-secondary ml-1">{{#str}}filter_active_grade, report_autograder{{/str}} {{filters.active_grade}}</span>
    {{/filters.active_grade}}
    {{#filters.active_status_label}}
    <span class="badge badge-primary ml-1">{{#str}}filter_active_status, report_autograder{{/str}} {{filters.active_status_label}}</span>
    {{/filters.active_status_label}}
</div>
{{/filters.has_active_filters}}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('report-search-input');
        const tableBody = document.querySelector('#report-autograder-root table tbody');

        const sortButtons = {
            'sort-name-btn': {
                columnIndex: 0,
                sortOrder: 'asc',
                iconAsc: 'fa-sort-alpha-asc',
                iconDesc: 'fa-sort-alpha-desc',
                type: 'string'
            },
            'sort-delivery-date-btn': {
                columnIndex: 1,
                sortOrder: 'asc',
                iconAsc: 'fa-sort-numeric-asc',
                iconDesc: 'fa-sort-numeric-desc',
                type: 'number'
            },
            'sort-completed-at-btn': {
                columnIndex: 4, // Assuming 'completed_at' is the 5th column (0-indexed)
                sortOrder: 'asc',
                iconAsc: 'fa-sort-numeric-asc',
                iconDesc: 'fa-sort-numeric-desc',
                type: 'number'
            }
        };

        if (searchInput) {
            searchInput.addEventListener('keyup', () => {
                const searchTerm = searchInput.value.toLowerCase();
                const tableRows = document.querySelectorAll('#report-autograder-root table tbody tr');
                tableRows.forEach(row => {
                    // Check if it's the "no records found" row.
                    if (row.querySelector('h4') && row.querySelector('h4').textContent.includes('No records found')) {
                        return; // Don't hide the "no records" message.
                    }
                    const rowText = row.textContent.toLowerCase();
                    if (rowText.includes(searchTerm)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        }

        Object.keys(sortButtons).forEach(buttonId => {
            const button = document.getElementById(buttonId);
            if (button) {
                button.addEventListener('click', () => {
                    const columnInfo = sortButtons[buttonId];
                    const rows = Array.from(tableBody.querySelectorAll('tr'));

                    rows.sort((rowA, rowB) => {
                        let valueA, valueB;

                        if (columnInfo.type === 'string') {
                            valueA = rowA.children[columnInfo.columnIndex].textContent.toLowerCase();
                            valueB = rowB.children[columnInfo.columnIndex].textContent.toLowerCase();
                        } else if (columnInfo.type === 'number') {
                            valueA = Number(rowA.children[columnInfo.columnIndex].dataset.sortValue || '0');
                            valueB = Number(rowB.children[columnInfo.columnIndex].dataset.sortValue || '0');
                            console.log(`Comparing numbers: ${valueA} vs ${valueB}`);
                        }

                        if (columnInfo.sortOrder === 'asc') {
                            return valueA.localeCompare ? valueA.localeCompare(valueB) : valueA - valueB;
                        } else {
                            return valueB.localeCompare ? valueB.localeCompare(valueA) : valueB - valueA;
                        }
                    });

                    // Clear current table body.
                    while (tableBody.firstChild) {
                        tableBody.removeChild(tableBody.firstChild);
                    }

                    // Append sorted rows.
                    rows.forEach(row => tableBody.appendChild(row));

                    // Toggle sort order and update icon.
                    const icon = button.querySelector('i');
                    Object.keys(sortButtons).forEach(id => {
                        const otherIcon = document.getElementById(id).querySelector('i');
                        if (id !== buttonId) {
                            // Reset other icons to default ascending, or just clear them.
                            otherIcon.classList.remove(sortButtons[id].iconDesc);
                            otherIcon.classList.add(sortButtons[id].iconAsc); // Or just remove both for neutral state.
                            sortButtons[id].sortOrder = 'asc';
                        }
                    });

                    if (columnInfo.sortOrder === 'asc') {
                        columnInfo.sortOrder = 'desc';
                        icon.classList.remove(columnInfo.iconAsc);
                        icon.classList.add(columnInfo.iconDesc);
                    } else {
                        columnInfo.sortOrder = 'asc';
                        icon.classList.remove(columnInfo.iconDesc);
                        icon.classList.add(columnInfo.iconAsc);
                    }
                });
            }
        });
    });
</script>
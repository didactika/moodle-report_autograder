<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        {{#hasprev}}
            <li class="page-item">
                <a class="page-link" href="#" data-page="{{prevpage}}" aria-label="Previous">
                    <span aria-hidden="true">&laquo; {{#str}} previous, core {{/str}}</span>
                </a>
            </li>
        {{/hasprev}}
        {{^hasprev}}
            <li class="page-item disabled">
                <span class="page-link" aria-hidden="true">&laquo; {{#str}} previous, core {{/str}}</span>
            </li>
        {{/hasprev}}

        <li class="page-item disabled">
            <span class="page-link">{{#str}} page, core {{/str}} {{currentpage}} / {{totalpages}}</span>
        </li>

        {{#hasnext}}
            <li class="page-item">
                <a class="page-link" href="#" data-page="{{nextpage}}" aria-label="Next">
                    <span aria-hidden="true">{{#str}} next, core {{/str}} &raquo;</span>
                </a>
            </li>
        {{/hasnext}}
        {{^hasnext}}
            <li class="page-item disabled">
                <span class="page-link" aria-hidden="true">{{#str}} next, core {{/str}} &raquo;</span>
            </li>
        {{/hasnext}}
    </ul>
</nav>

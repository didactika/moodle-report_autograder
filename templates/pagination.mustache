{{!
    @template report_autograder/pagination

    The page size picker and the previous and next buttons under the table.

    Context variables required for this template:
    * from - The first row shown
    * to - The last row shown
    * total - How many rows there are
    * hasprev - Whether there is a previous page
    * hasnext - Whether there is a next page
    * prevpage - The previous page's number
    * nextpage - The next page's number
    * peroptions - The page sizes offered, each with a value and whether it
      is selected or stands for every result

    Example context (json):
    {
        "from": 1,
        "to": 12,
        "total": 40,
        "hasprev": false,
        "hasnext": true,
        "prevpage": 0,
        "nextpage": 2,
        "peroptions": [
            {"value": 12, "selected": true, "is_all": false},
            {"value": 24, "selected": false, "is_all": false},
            {"value": 40, "selected": false, "is_all": true}
        ]
    }
}}
<div class="table-foot">
    <nav class="dd-pager" aria-label="{{#str}}pagination:label, report_autograder{{/str}}">
        <div class="dd-pager-size">
            <label for="autograder-per-page" class="mb-0">{{#str}}pagination:results_per_page, report_autograder{{/str}}</label>
            <select id="autograder-per-page" class="custom-select form-select form-select-sm custom-select-sm dd-select">
                {{#peroptions}}
                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{#is_all}}{{#all_results_label}}{{.}}{{/all_results_label}}{{^all_results_label}}{{#str}}pagination:all_results, report_autograder{{/str}}{{/all_results_label}}{{/is_all}}{{^is_all}}{{value}}{{/is_all}}</option>
                {{/peroptions}}
            </select>
        </div>
        <div class="dd-pager-end">
            <span class="dd-pager-range" role="status" aria-live="polite">{{from}}–{{to}} {{#str}}pagination:of, report_autograder{{/str}} {{total}}</span>
            <div class="dd-pager-arrows">
                <button type="button" class="autograder-page-nav btn btn-outline-secondary btn-sm btn-icon" data-page="{{prevpage}}"
                    title="{{#str}}pagination:previous, report_autograder{{/str}}" aria-label="{{#str}}pagination:previous, report_autograder{{/str}}"{{^hasprev}} disabled{{/hasprev}}>{{#pix}}i/previous, core{{/pix}}</button>
                <button type="button" class="autograder-page-nav btn btn-outline-secondary btn-sm btn-icon" data-page="{{nextpage}}"
                    title="{{#str}}pagination:next, report_autograder{{/str}}" aria-label="{{#str}}pagination:next, report_autograder{{/str}}"{{^hasnext}} disabled{{/hasnext}}>{{#pix}}i/next, core{{/pix}}</button>
            </div>
        </div>
    </nav>
</div>

{{!
    @template report_autograder/partials/_filters

    Filter form for autograder report.

    Context variables:
    * filters.searchname - Search name filter value
    * filters.submission_date_from - Submission date start value
    * filters.submission_date_to - Submission date end value
    * filters.grading_date_from - Grading date start value
    * filters.grading_date_to - Grading date end value
    * filters.grade - Grade filter value
    * filters.status - Selected status filter value
    * filters.status_pending - Boolean if pending status is selected
    * filters.status_graded - Boolean if graded status is selected
    * filters.status_manual_grading - Boolean if manual_grading status is selected
    * filters.has_active_filters - Boolean if any filter is active
    * filters.active_count - Number of active filters
    * filters.active_searchname - Label for active search name filter
    * filters.active_datefrom - Label for active date from filter
    * filters.active_dateto - Label for active date to filter
    * filters.active_grade - Label for active grade filter
    * filters.active_status_label - Label for active status filter
    * filter_action_url - URL to submit the filter form to (typically index.php)
}}

<form method="get" action="{{filter_action_url}}" id="autograder-filter-form" class="mb-3 mt-3"
    data-status-placeholder="{{#str}}filter_status_placeholder, report_autograder{{/str}}"
    data-submission-label="{{#str}}filter_submission_date, report_autograder{{/str}}"
    data-grading-label="{{#str}}filter_grading_date, report_autograder{{/str}}"
    data-dp-apply="{{#str}}datepicker_apply, report_autograder{{/str}}"
    data-dp-cancel="{{#str}}datepicker_cancel, report_autograder{{/str}}"
    data-dp-from="{{#str}}datepicker_from, report_autograder{{/str}}"
    data-dp-to="{{#str}}datepicker_to, report_autograder{{/str}}"
    data-dp-custom="{{#str}}datepicker_custom, report_autograder{{/str}}"
    data-dp-week="{{#str}}datepicker_week, report_autograder{{/str}}"
    data-status-pending-label="{{#str}}filter_status_pending, report_autograder{{/str}}"
    data-status-manual-label="{{#str}}filter_status_manual_grading, report_autograder{{/str}}"
    data-status-graded-label="{{#str}}filter_status_graded, report_autograder{{/str}}">
    <div class="autograder-top-filters">
        <div class="autograder-quick-search-wrapper">
            <i class="fa fa-search autograder-quick-search-icon" aria-hidden="true"></i>
            <input type="text" class="form-control shadow-none autograder-quick-search-input autograder-unified-input" placeholder="{{#str}}filter_search, report_autograder{{/str}}..." aria-label="{{#str}}filter_search, report_autograder{{/str}}" id="autograder-quick-search-input" value="{{filters.searchname}}">
            <input type="hidden" name="searchname" id="searchname" value="{{filters.searchname}}">
        </div>

        <div class="autograder-right-filters d-flex flex-nowrap">
            <!-- Grading Date Filter Chip (clear is outside main button so clicks work; overlay input stays pointer-events: none) -->
            <div class="autograder-date-field-wrapper">
                <div class="autograder-date-chip-host position-relative">
                    <button type="button" id="grading-date-button"
                        class="btn filter-btn autograder-chip-button d-flex align-items-center"
                        aria-haspopup="dialog"
                        aria-label="{{#str}}filter_grading_date, report_autograder{{/str}}">
                        <span id="grading-date-text" class="autograder-chip-text">{{#str}}filter_grading_date, report_autograder{{/str}}</span>
                        <span id="grading-date-arrow" class="ml-2 border-0" aria-hidden="true">
                            <i class="fa fa-chevron-down"></i>
                        </span>
                    </button>
                    <button type="button" id="grading-date-clear"
                        class="autograder-chip-clear-btn d-none"
                        aria-label="{{#str}}datepicker_cancel, report_autograder{{/str}}">
                        <i class="fa fa-times-circle" aria-hidden="true"></i>
                    </button>
                </div>
                <input type="text" id="grading_date_range" class="form-control autograder-daterange-input d-none" autocomplete="off" placeholder="{{#str}}filter_grading_date, report_autograder{{/str}}" data-picker-title="{{#str}}filter_grading_date, report_autograder{{/str}}">
                <input type="hidden" name="grading_date_from" id="grading_date_from" value="{{filters.grading_date_from}}">
                <input type="hidden" name="grading_date_to" id="grading_date_to" value="{{filters.grading_date_to}}">
            </div>

            <!-- Status Filter -->
            <div class="autograder-status-filter-wrapper">
                <div class="autograder-status-multiselect autograder-status-dropdown" id="autograder-status-multiselect">
                    <button type="button" id="status-multiselect-toggle"
                        class="btn filter-btn autograder-chip-button autograder-status-button d-flex align-items-center"
                        aria-haspopup="true" aria-expanded="false">
                        <span id="selected-status-text" class="autograder-chip-text">{{#str}}filter_status_placeholder, report_autograder{{/str}}</span>
                        <span id="status-selection-count" class="ml-2 d-none"></span>
                        <span id="status-chevron" class="ml-2" aria-hidden="true">
                            <i class="fa fa-chevron-down"></i>
                        </span>
                        <span id="clear-status" class="ml-2 border-0 d-none" aria-label="Clear selection">
                            <i class="fa fa-times-circle"></i>
                        </span>
                    </button>
                    <ul class="autograder-status-menu dropdown-menu shadow" id="filter-status-popup" role="menu">
                        <li class="list-item">
                            <button class="dropdown-item d-flex align-items-center justify-content-start px-2 py-2" data-value="PENDING">
                                <input type="checkbox" class="autograder-status-checkbox d-none" id="status-pending" value="PENDING" {{#filters.status_pending}}checked{{/filters.status_pending}}>
                                <label class="m-0 autograder-status-label" for="status-pending">{{#str}}filter_status_pending, report_autograder{{/str}}</label>
                            </button>
                        </li>
                        <li class="list-item">
                            <button class="dropdown-item d-flex align-items-center justify-content-start px-2 py-2" data-value="MANUAL_GRADING">
                                <input type="checkbox" class="autograder-status-checkbox d-none" id="status-manual-grading" value="MANUAL_GRADING" {{#filters.status_manual_grading}}checked{{/filters.status_manual_grading}}>
                                <label class="m-0 autograder-status-label" for="status-manual-grading">{{#str}}filter_status_manual_grading, report_autograder{{/str}}</label>
                            </button>
                        </li>
                        <li class="list-item">
                            <button class="dropdown-item d-flex align-items-center justify-content-start px-2 py-2" data-value="GRADED">
                                <input type="checkbox" class="autograder-status-checkbox d-none" id="status-graded" value="GRADED" {{#filters.status_graded}}checked{{/filters.status_graded}}>
                                <label class="m-0 autograder-status-label" for="status-graded">{{#str}}filter_status_graded, report_autograder{{/str}}</label>
                            </button>
                        </li>
                    </ul>
                </div>
                <input type="hidden" name="status" id="status" value="{{filters.status}}">
            </div>
        </div>
    </div>
</form>
{{#filters.has_active_filters}}
<div class="alert alert-info mb-3">
    <strong>{{#str}}filter_active, report_autograder{{/str}}</strong>
    {{#filters.active_searchname}}
    <span class="badge badge-secondary ml-1">{{#str}}filter_active_searchname, report_autograder{{/str}} {{filters.active_searchname}}</span>
    {{/filters.active_searchname}}
    {{#filters.active_datefrom}}
    <span class="badge badge-secondary ml-1">{{#str}}filter_active_datefrom, report_autograder{{/str}} {{filters.active_datefrom}}</span>
    {{/filters.active_datefrom}}
    {{#filters.active_dateto}}
    <span class="badge badge-secondary ml-1">{{#str}}filter_active_dateto, report_autograder{{/str}} {{filters.active_dateto}}</span>
    {{/filters.active_dateto}}
    {{#filters.active_grade}}
    <span class="badge badge-secondary ml-1">{{#str}}filter_active_grade, report_autograder{{/str}} {{filters.active_grade}}</span>
    {{/filters.active_grade}}
    {{#filters.active_status_label}}
    <span class="badge badge-primary ml-1">{{#str}}filter_active_status, report_autograder{{/str}} {{filters.active_status_label}}</span>
    {{/filters.active_status_label}}
</div>
{{/filters.has_active_filters}}

@startuml
!theme plain
skinparam linetype polyline
left to right direction

package "Moodle" {
  [Reports menu and navigation]
  [Capabilities]
  [Groups]
  [Gradebook]
  [Web services (AJAX)]
}
package "report_autograder" {
  [Pages]
  [AMD modules and templates]
  [Report services]
}
package "local_autograder" {
  [Decisions]
  [Grader picker]
}

[Reports menu and navigation] --> [Pages]
[Pages] --> [AMD modules and templates]
[AMD modules and templates] --> [Web services (AJAX)]
[Web services (AJAX)] --> [Report services]
[Report services] --> [Capabilities]
[Report services] --> [Groups]
[Report services] --> [Gradebook]
[Report services] --> [Decisions]
[Report services] --> [Grader picker]

@enduml

@startuml
!theme plain
skinparam linetype polyline
hide empty description

state "narrowReport" as narrowReport {
  state " " as Showing
  state " " as Searching
  state " " as Narrowed

  [*] --> Showing : Reader opens a report
  Showing --> Searching : Reader types in an activity or course picker
  Searching --> Showing : System lists the options the reader may see
  Showing --> Narrowed : Reader chooses a value in the menu of a filter
  Narrowed --> Showing : System shows the rows, the total and the counts
  Narrowed --> Showing : Reader lifts a filter or clears every filter
  Showing --> [*] : Reader leaves the report

  note on link
    Reader: narrows the report
    System: counts and lists inside the filters
  end note
}

@enduml

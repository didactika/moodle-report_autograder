@startuml
!theme plain
hide empty members
skinparam linetype polyline
top to bottom direction

class "Administrator" as user <<actor>>
class "Graders page" as screen <<boundary>>
class "Grader list" as list <<control>>
class "Grader picker" as picker <<control>>
class "Decision" as decision <<entity>>

user --> screen : 1: chooses a course
screen --> list : 2: the teachers of the course
list --> picker : 3: who may grade, who is the fallback
user --> screen : 4: asks for the students
screen --> list : 5: a page of students with their grader

@enduml

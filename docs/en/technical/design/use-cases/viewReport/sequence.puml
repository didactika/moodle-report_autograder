@startuml
!theme plain
skinparam linetype polyline
skinparam responseMessageBelowArrow true

actor "Teacher" as actor
participant "Report.tsx" as js
participant "get_report" as service
participant "scope" as scope
participant "group_access" as groups
participant "report_query" as query
database "local_autograder_decision" as table

actor -> js : filters, page, sort
js -> service : cmid, courseid, filters, page
service -> scope : require_capability()
service -> groups : for_scope(scope)
service -> query : rows(scope, filters, groups)
query -> table : read decisions and the students not yet engaged
query --> service : rows
service -> query : status_counts(scope, filters without the status)
query --> service : the students of each status
service --> js : formatted rows (status, date, grade, grader) and the counts
js --> actor : the table

@enduml

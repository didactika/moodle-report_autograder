@startuml
!theme plain
hide circle
skinparam linetype polyline

entity local_autograder_decision <<read only>> {
  * id : int
  --
  cmid : int
  courseid : int
  userid : int
  status : char(20)
  scheduledgradetime : int
  graderid : int
  gradedvalue : number
  failurereason : char(40)
}
entity local_autograder_config <<read only>> {
  * id : int
  --
  cmid : int
  enabled : bool
  gradevalue : number
  delayseconds : int
}
entity grade_grades <<Moodle>> {
  userid : int
  finalgrade : number
}

local_autograder_config ||..o{ local_autograder_decision : cmid
local_autograder_decision }o..o| grade_grades : the grade in the gradebook

@enduml

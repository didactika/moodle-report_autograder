@startuml
!theme plain
hide empty members
skinparam linetype polyline
top to bottom direction

class "Administrator" as user <<actor>>
class "Report page" as screen <<boundary>>
class "Scope" as scope <<control>>
class "Filters" as filters <<control>>
class "Report query" as query <<control>>
class "Decision" as decision <<entity>>

user --> screen : 1: opens the report, chooses a filter
screen --> scope : 2: site level, viewsite
screen --> filters : 3: at least one filter?
screen --> query : 4: the rows of the page
query --> decision : 5: reads decisions and the gradebook

@enduml

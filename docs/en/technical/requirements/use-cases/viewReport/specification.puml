@startuml
!theme plain
skinparam linetype polyline
hide empty description

state "viewReport" as viewReport {
  state " " as Menu
  state " " as Table
  state " " as Narrowed

  [*] --> Menu : Teacher opens the report from the activity or from the course
  Menu --> Table : System checks the capability and reads the first page
  Table --> Narrowed : Teacher searches, filters or sorts
  Narrowed --> Table : Teacher clears the filters
  Table --> [*] : Teacher leaves the report

  note on link
    Teacher: searches and filters
    System: reads only the groups the teacher can see
  end note
}

@enduml
